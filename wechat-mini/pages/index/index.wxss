page {
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: #fbf7ee;
}

web-view {
  width: 100%;
  height: 100%;
}

.setup {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  box-sizing: border-box;
}

.setup-card {
  width: 100%;
  padding: 52rpx 40rpx;
  border-radius: 28rpx;
  background: #fffdf8;
  border: 2rpx solid rgba(53, 41, 27, 0.1);
}

.setup-title {
  color: #2b2117;
  font-size: 36rpx;
  font-weight: 700;
}

.setup-text {
  margin-top: 20rpx;
  color: #706453;
  font-size: 26rpx;
  line-height: 1.7;
}

.setup-code {
  margin-top: 28rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: #f4eadb;
  color: #e0582f;
  font-size: 22rpx;
  word-break: break-all;
}
